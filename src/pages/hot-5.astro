---
import Layout from "@/layouts/Layout.astro";
import { KANA } from "@/lib/kana";
import { rankHotFive } from "@/lib/hot-five";
import { getCharStats } from "@/lib/services/session-store";

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
if (!user || !supabase) {
  return new Response("Supabase is not configured", { status: 500 });
}
const stats = await getCharStats(supabase);
const items = rankHotFive(stats).flatMap((stat) => {
  const entry = KANA.find((kana) => kana.romaji === stat.romaji);
  return entry ? [{ ...stat, hiragana: entry.hiragana, katakana: entry.katakana }] : [];
});
---

<Layout title="Hot 5">
  <div class="bg-cosmic flex min-h-dvh items-start justify-center p-4 sm:items-center">
    <div class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <a href="/dashboard" class="mb-4 inline-block py-2 text-sm text-purple-300 hover:text-purple-100 hover:underline">
        ← Back to dashboard
      </a>
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Hot 5
      </h1>
      {items.length === 0 ? (
        <div class="text-center">
          <p class="text-blue-100/80">No mistakes in your recent answers.</p>
          <a
            href="/practice"
            class="mt-4 inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
          >
            Start practice
          </a>
        </div>
      ) : (
        <ol class="space-y-2" aria-label="Your five most difficult characters">
          {items.map((item, index) => (
            <li
              class="flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3"
              aria-label={`${index + 1}. ${item.romaji}, ${item.errors} errors out of ${item.answers} answers`}
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="w-6 shrink-0 text-lg font-bold text-purple-300">{index + 1}</span>
                <span class="text-3xl" lang="ja">
                  {item.hiragana} {item.katakana}
                </span>
                <span class="text-lg break-words text-blue-100/80">{item.romaji}</span>
              </span>
              <span class="shrink-0 text-lg font-bold">
                {item.errors}/{item.answers}
              </span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
</Layout>
