---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

const { user } = Astro.locals;

const primaryAction = buttonVariants({ size: "lg", className: "h-12 w-full text-base" });
const secondaryAction = buttonVariants({ variant: "outline", size: "lg", className: "h-12 w-full text-base" });
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center backdrop-blur-xl">
      <CardHeader>
        <CardTitle>
          <h1 class="text-foreground text-3xl font-bold">Dashboard</h1>
        </CardTitle>
        <CardDescription>
          Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
        </CardDescription>
      </CardHeader>
      <CardContent className="flex flex-col gap-3">
        <a href="/practice" class:list={primaryAction}>
          Start practice
        </a>
        <a href="/results" class:list={secondaryAction}>
          Results
        </a>
        <a href="/hot-5" class:list={secondaryAction}>
          Hot-5
        </a>
        <a href="/mastery" class:list={secondaryAction}>
          Mastery
        </a>
        <form method="POST" action="/api/auth/signout" class="mt-1">
          <button type="submit" class:list={secondaryAction}>
            Sign out
          </button>
        </form>
      </CardContent>
    </Card>
  </div>
</Layout>
