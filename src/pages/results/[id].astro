---
import Layout from "@/layouts/Layout.astro";
import { KANA } from "@/lib/kana";
import { uniqueRomaji } from "@/lib/services/session";
import { getResult } from "@/lib/services/session-store";
import { formatSessionDate, DIRECTION_LABELS, ALPHABET_LABELS } from "@/lib/results-format";

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
if (!user || !supabase) {
  return new Response("Supabase is not configured", { status: 500 });
}
const result = Astro.params.id ? await getResult(supabase, user.id, Astro.params.id) : null;

if (!result) {
  Astro.response.status = 404;
}

const session = result?.session;
const mistakes = uniqueRomaji(result?.mistakes ?? []).map((romaji) => ({
  romaji,
  kana: session ? KANA.find((entry) => entry.romaji === romaji)?.[session.alphabet] : undefined,
}));
---

<Layout title="Result">
  <div class="bg-cosmic flex min-h-dvh items-start justify-center p-4 sm:items-center">
    <div class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <a href="/results" class="mb-4 inline-block py-2 text-sm text-purple-300 hover:text-purple-100 hover:underline">
        ← Back to results
      </a>
      {session ? (
        <div class="space-y-6">
          <div class="text-center">
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              Session result
            </h1>
            <p class="mt-3 text-5xl font-bold">
              {session.score ?? 0}/{session.total}
            </p>
            <p class="mt-2 text-sm text-blue-100/70">{formatSessionDate(session.completedAt ?? session.createdAt)}</p>
            <p class="text-sm text-blue-100/70">
              {ALPHABET_LABELS[session.alphabet]} · {DIRECTION_LABELS[session.direction]}
            </p>
          </div>
          {mistakes.length === 0 ? (
            <p class="text-center text-green-200">Perfect session! Every character was recognised correctly.</p>
          ) : (
            <div class="space-y-2">
              <h2 class="text-sm font-medium text-blue-100/80">Characters to review</h2>
              <ul class="space-y-2">
                {mistakes.map(({ romaji, kana }) => (
                  <li class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3">
                    <span class="text-3xl" lang="ja">
                      {kana}
                    </span>
                    <span class="text-lg text-blue-100/80">{romaji}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ) : (
        <div class="text-center">
          <h1 class="text-2xl font-bold">Result not found</h1>
          <p class="mt-2 text-blue-100/80">This session does not exist or is not yours.</p>
        </div>
      )}
    </div>
  </div>
</Layout>
